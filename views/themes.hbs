<div class="app-layout">
  {{> sidebar}}
  <main class="main-panel">
    <h1>Choose Your Theme</h1><p>Your space, your mood.</p>
    <section class="theme-grid">
      <button class="theme-card linen" data-theme-choice="linen">Linen</button>
      <button class="theme-card olive" data-theme-choice="olive">Olive Grove</button>
      <button class="theme-card cocoa" data-theme-choice="cocoa">Cocoa Dusk</button>
      <button class="theme-card midnight" data-theme-choice="midnight">Midnight Draft</button>
      <button class="theme-card vintage" data-theme-choice="vintage">Vintage Book</button>
    </section>
  </main>
</div>
