{{> nav}}
<main>
  <section class="hero page-shell">
    <div class="hero-copy">
      <p class="eyebrow">Your space. Your words.</p>
      <h1>A sanctuary for your thoughts.</h1>
      <p>Write, reflect, and grow with daily prompts, focus timers, saved drafts, blogs, and themes that make writing feel like a ritual.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/dashboard">Get Started</a>
        <a class="btn btn-ghost" href="/write_poems">Try Writing</a>
      </div>
    </div>
    <div class="hero-art">
      <div class="notebook-card">
        <span>10:00</span>
        <h3>Begin your thoughts...</h3>
        <p>Write about a place that still remembers you.</p>
      </div>
    </div>
  </section>

  <section class="features page-shell">
    <h2>Everything you need to write better</h2>
    <div class="feature-grid">
      {{#each features}}
      <article class="feature-card">
        <div class="feature-icon">{{icon}}</div>
        <h3>{{title}}</h3>
        <p>{{text}}</p>
      </article>
      {{/each}}
    </div>
  </section>
</main>
